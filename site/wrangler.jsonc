{
  // The Worker serves the reference of the rules at stiles-rules.aonyx.ai.
  // The Custom Domain that binds the address to the Worker lives in den, and
  // it gives the Worker by this name, so the two names have to agree.
  "name": "stiles-rules",
  "compatibility_date": "2026-11-01",
  // The Worker has no code: Cloudflare serves every request from the assets.
  // A workers.dev hostname would be a second public origin of the same page,
  // so the Worker answers only on its Custom Domain.
  "workers_dev": false,
  "assets": {
    // `just reference` writes the page here, relative to this file. The
    // workflow builds it before every deploy, and the directory is not in
    // the repository.
    "directory": "public",
  },
}
